{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "cloud-browser",
  "description": "Capability for cloud browser windows (cloud-browser-*)",
  "windows": ["cloud-browser-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit-to",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "dialog:allow-open"
  ]
}
